# Copy to backend/.env. Never commit real provider keys.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
MAX_REQUEST_BYTES=65536
LOG_LEVEL=INFO

# Leave empty to disable external targets. Exact HTTP(S) origins only.
# Even an allowlisted private IP is blocked outside the controlled fixture path.
YOKAI_ALLOWED_ORIGINS=
# Public website testing (also supported in production); keeps private-network checks.
# The deployment Dockerfile enables this by default. Explicit runtime env values override it.
YOKAI_PUBLIC_TARGETS_ENABLED=false
LOCAL_FIXTURES_ENABLED=true
YOKAI_MAX_CONCURRENCY=2
YOKAI_MAX_QUEUE=12
YOKAI_JOB_TTL_SECONDS=900

# Operator-configured providers only. HTTPS required except loopback in development.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
RPC_TIMEOUT_SECONDS=4
KAGAMI_TIMEOUT_SECONDS=12
KAGAMI_MAX_CONCURRENCY=2
APPROVAL_LOOKBACK_BLOCKS=1000
APPROVAL_CHUNK_BLOCKS=1000
APPROVAL_MAX_CANDIDATES=50

# Enable only after confirming eth_simulateV1 support on the configured RPC.
# Example: SIMULATION_NETWORKS=sepolia
SIMULATION_NETWORKS=
# Optional historical Approval candidates from fixed Blockscout endpoints; RPC verifies state.
APPROVAL_INDEXER_NETWORKS=
SNAPSHOT_TTL_SECONDS=900
SNAPSHOT_MAX_RECORDS=200
RATE_LIMIT_PER_MINUTE=120

# Production: APP_ENV=production and LOCAL_FIXTURES_ENABLED=false.
# Configure exact production CORS origins and network-level browser isolation.
