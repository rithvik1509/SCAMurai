# Copy this file to backend/.env for local development.
# backend/.env is git-ignored. Never commit real credentials or secrets.

# development | test | production
APP_ENV=development

# Comma-separated, explicit browser origins allowed to call the API.
# Wildcards are rejected. Must match the frontend origin exactly
# (scheme + host + port, no path, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum accepted request body, in bytes. Allowed range: 1024..10485760.
MAX_REQUEST_BYTES=65536

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
